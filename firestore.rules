rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // For this app, we consider the primary user/owner as admin.
      // In a production environment, you would check a specific 'admins' collection.
      return isSignedIn() && request.auth.token.email == 'chesling1@gmail.com';
    }

    function isValidArtwork(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.year is string && data.year.size() <= 10 &&
             data.image is string && data.image.size() <= 1000 &&
             data.description is string && data.description.size() <= 2000 &&
             data.order is number;
    }

    function isValidInquiry(data) {
      return data.fullName is string && data.fullName.size() <= 200 &&
             data.email is string && data.email.matches('^.+@.+\\..+$') &&
             data.message is string && data.message.size() <= 2000 &&
             data.type in ['purchase', 'rent'] &&
             data.artworkId is string;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Artworks: Publicly readable, admin writable
    match /artworks/{artworkId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && (request.method == 'delete' || isValidArtwork(request.resource.data));
    }

    // Inquiries: Admin readable, Publicly creatable, no updates
    match /inquiries/{inquiryId} {
      allow read: if isAdmin();
      allow create: if isValidInquiry(request.resource.data);
      allow update, delete: if isAdmin();
    }
  }
}
